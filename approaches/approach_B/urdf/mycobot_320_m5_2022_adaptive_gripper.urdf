<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter" >
	
<xacro:property name="width" value=".2" />




  <!-- World anchor: fixes robot base to the world frame in Gazebo -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base">
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/base.dae"/>
      </geometry>
    <origin xyz = "0.0 0 0 " rpy = " 0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/base.dae"/>
        </geometry>
        <origin xyz = "0.0 0 0 " rpy = " 0 0 1.5708"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link1.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.078" rpy="0 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link1.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.078" rpy="0 0 1.5708"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="link2">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link2.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.04" rpy="0 1.5708 0"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link2.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.04" rpy="0 1.5708 0"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="link3">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link3.dae"/></geometry>
      <origin xyz="0.0 0.0 0.039" rpy="1.5708 1.5708 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link3.dae"/></geometry>
      <origin xyz="0.0 0.0 0.039" rpy="1.5708 1.5708 1.5708"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="link4">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link4.dae"/></geometry>
      <origin xyz="0.0 -0.0024 -0.05" rpy="1.5708 1.5708 0"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link4.dae"/></geometry>
      <origin xyz="0.0 -0.0024 -0.05" rpy="1.5708 1.5708 0"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="link5">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link5.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.05" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link5.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.05" rpy="0 0 -1.5708"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="link6">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link6.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.0115" rpy="1.5708 1.5708 0"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_320_m5_2022/link6.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.0115" rpy="1.5708 1.5708 0"/>
    </collision>
    <inertial><mass value="0.3"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="gripper_base">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_base.dae"/></geometry>
      <origin xyz="-0.02 0.012 -0.018" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_base.dae"/></geometry>
      <origin xyz="-0.02 0.012 -0.018" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.1"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_left1">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left1.dae"/></geometry>
      <origin xyz="0.048 -0.035 -0.003" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left1.dae"/></geometry>
      <origin xyz="0.048 -0.035 -0.003" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_left2">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left2.dae"/></geometry>
      <origin xyz="0.026 0.022 -0.018" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left2.dae"/></geometry>
      <origin xyz="0.026 0.022 -0.018" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_left3">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left3.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.018" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_left3.dae"/></geometry>
      <origin xyz="0.0 0.0 -0.018" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_right1">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right1.dae"/></geometry>
      <origin xyz="-0.086 -0.036 -0.003" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right1.dae"/></geometry>
      <origin xyz="-0.086 -0.036 -0.003" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_right2">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right2.dae"/></geometry>
      <origin xyz="-0.062 0.0224 -0.018" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right2.dae"/></geometry>
      <origin xyz="-0.062 0.0224 -0.018" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="gripper_right3">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right3.dae"/></geometry>
      <origin xyz="-0.034 0.0 -0.018" rpy="1.5708 0 1.5708"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/pro_adaptive_gripper/gripper_right3.dae"/></geometry>
      <origin xyz="-0.034 0.0 -0.018" rpy="1.5708 0 1.5708"/>
    </collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1739" rpy="0 0 0"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.35" upper="2.35" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 -0.08878 0" rpy="0 -1.5708 1.5708"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.135 0 -0.08878" rpy="0 0 0"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.120 0 0.08878" rpy="0 0 1.5708"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 -0.095 0.0" rpy="1.5708 0 0"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.0655 0.0" rpy="-1.5708 0 0"/>
  </joint>

  <joint name="joint6output_to_gripper_base" type="fixed">
    <!-- <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.05" upper = "3.05" velocity = "0"/> -->
    <parent link="link6"/>
    <child link="gripper_base"/>
     <origin xyz= "0.0 -0.007 0.056" rpy = "1.5708 0 0"/>
  </joint>

  <joint name="gripper_controller" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.11" upper="0" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_base"/>
    <child link="gripper_left3"/>
    <origin xyz="-0.018 0.015 0" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_base_to_gripper_left2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.11" upper="0.5" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_base"/>
    <child link="gripper_left2"/>
    <origin xyz="-0.047 -0.01 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
  </joint>

  <joint name="gripper_left3_to_gripper_left1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.5" upper="1.11" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_left3"/>
    <child link="gripper_left1"/>
    <origin xyz="-0.05 0.035 -0.015" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_base_to_gripper_right3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.3" upper="1.11" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_base"/>
    <child link="gripper_right3"/>
    <origin xyz="0.016 0.014 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_base_to_gripper_right2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.5" upper="1.11" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_base"/>
    <child link="gripper_right2"/>
    <origin xyz="0.044 -0.01 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_right3_to_gripper_right1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.11" upper="0.5" velocity="1.0"/>
    <dynamics damping="50.0" friction="5.0"/>
    <parent link="gripper_right3"/>
    <child link="gripper_right1"/>
    <origin xyz="0.052 0.035 -0.015" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
  </joint>


  <!-- ros2_control hardware interface for Gazebo Harmonic -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint2_to_joint1">
      <command_interface name="position"><param name="min">-2.93</param><param name="max">2.93</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.644</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3_to_joint2">
      <command_interface name="position"><param name="min">-2.35</param><param name="max">2.35</param></command_interface>
      <state_interface name="position"><param name="initial_value">1.57</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4_to_joint3">
      <command_interface name="position"><param name="min">-2.53</param><param name="max">2.53</param></command_interface>
      <state_interface name="position"><param name="initial_value">-1.57</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5_to_joint4">
      <command_interface name="position"><param name="min">-2.53</param><param name="max">2.53</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="joint6_to_joint5">
      <command_interface name="position"><param name="min">-2.93</param><param name="max">2.93</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="joint6output_to_joint6">
      <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_controller">
      <command_interface name="position"><param name="min">-1.11</param><param name="max">0.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <!-- Mimic joints: gz_ros2_control mirrors gripper_controller command automatically -->
    <joint name="gripper_base_to_gripper_left2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"><param name="min">-1.11</param><param name="max">0.5</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left3_to_gripper_left1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"><param name="min">-0.5</param><param name="max">1.11</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_base_to_gripper_right3">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"><param name="min">-0.3</param><param name="max">1.11</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_base_to_gripper_right2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"><param name="min">-0.5</param><param name="max">1.11</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right3_to_gripper_right1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"><param name="min">-1.11</param><param name="max">0.5</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gripper finger surfaces: high friction for reliable grasping -->
  <gazebo reference="gripper_left1"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="gripper_left2"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="gripper_left3"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="gripper_right1"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="gripper_right2"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="gripper_right3"><surface><contact><ode><min_depth>0.0</min_depth><kp>1e6</kp><kd>1.0</kd></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></gazebo>

  <!-- Gazebo Harmonic gz_ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mycobot_320)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>